<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Hyperlink?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextArea?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>

<StackPane
        style="-fx-background-color: linear-gradient(to bottom right, #0F172A, #1E293B);"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.CustomerRegisterController">

    <VBox
            alignment="CENTER"
            spacing="20">

        <!-- Logo -->

        <Label
                text="LaundryLink"
                style="-fx-font-size: 36px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;" />

        <Label
                text="Create your customer account"
                style="-fx-font-size: 15px;
                       -fx-text-fill: #CBD5E1;" />


        <!-- Registration Card -->

        <VBox
                alignment="CENTER"
                maxWidth="450"
                prefWidth="450"
                spacing="14"
                style="-fx-background-color: rgba(255,255,255,0.08);
                       -fx-background-radius: 20;
                       -fx-border-color: rgba(255,255,255,0.15);
                       -fx-border-radius: 20;
                       -fx-padding: 35;">

            <Label
                    text="Customer Registration"
                    style="-fx-font-size: 25px;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;" />


            <!-- Name -->

            <TextField
                    fx:id="nameField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Full Name"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Phone -->

            <TextField
                    fx:id="phoneField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Phone Number"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Email -->

            <TextField
                    fx:id="emailField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Email Address"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Address -->

            <TextArea
                    fx:id="addressField"
                    maxWidth="350"
                    prefHeight="70"
                    promptText="Address"
                    wrapText="true"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Username -->

            <TextField
                    fx:id="usernameField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Username"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Password -->

            <PasswordField
                    fx:id="passwordField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Password"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Confirm Password -->

            <PasswordField
                    fx:id="confirmPasswordField"
                    maxWidth="350"
                    prefHeight="42"
                    promptText="Confirm Password"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />


            <!-- Buttons -->

            <HBox
                    alignment="CENTER"
                    spacing="12">

                <Button
                        text="CREATE ACCOUNT"
                        onAction="#register"
                        prefHeight="45"
                        prefWidth="190"
                        style="-fx-background-color: #38BDF8;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 12;
                               -fx-cursor: hand;" />

                <Button
                        text="CLEAR"
                        onAction="#clearForm"
                        prefHeight="45"
                        prefWidth="100"
                        style="-fx-background-color: #334155;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-background-radius: 12;
                               -fx-cursor: hand;" />

            </HBox>


            <!-- Login -->

            <Label
                    text="Already have an account?"
                    style="-fx-text-fill: #94A3B8;" />

            <Hyperlink
                    text="Back to Login"
                    onAction="#goLogin"
                    style="-fx-text-fill: #38BDF8;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;" />

        </VBox>


        <!-- Footer -->

        <Label
                text="© 2026 LaundryLink"
                style="-fx-text-fill: #94A3B8;" />

    </VBox>

</StackPane>
