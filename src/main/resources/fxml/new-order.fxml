<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color:#0B1120;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="25" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

            <!-- Header -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label style="-fx-text-fill:white;                                   -fx-font-size:30px;                                   -fx-font-weight:bold;" text="Create New Order" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-size:14px;" text="Fill in the details below to create a laundry order" />

                </VBox>

                <Button fx:id="dashboardBtn" prefHeight="42" prefWidth="140" style="-fx-background-color:#2563EB;                                -fx-text-fill:white;                                -fx-font-size:14px;                                -fx-font-weight:bold;                                -fx-background-radius:10;                                -fx-cursor:hand;" text="🏠 Dashboard" />

            </HBox>

            <!-- Form Card -->

            <VBox spacing="22" style="-fx-background-color:#111827;                          -fx-background-radius:20;                          -fx-padding:30;">

                <Label style="-fx-text-fill:white;                               -fx-font-size:18px;                               -fx-font-weight:bold;" text="Order Information" />

                <GridPane hgap="20" vgap="18">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Customer Name -->

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Customer Name" />

                        <TextField fx:id="nameField" prefHeight="48" promptText="Enter customer name" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <!-- Phone -->

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Phone Number" />

                        <TextField fx:id="phoneField" prefHeight="48" promptText="01XXXXXXXXX" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <!-- Service -->

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Service Type" />

                        <ComboBox fx:id="serviceBox" maxWidth="Infinity" prefHeight="48" promptText="Select Service" style="-fx-background-color:#1E293B;                                          -fx-control-inner-background:#1E293B;                                          -fx-background-radius:10;                                          -fx-border-radius:10;                                          -fx-border-color:#334155;" />
                    </VBox>

                    <!-- Quantity -->

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Quantity" />

                        <TextField fx:id="quantityField" prefHeight="48" promptText="Number of items" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <!-- Pickup Date -->

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Pickup Date" />

                        <DatePicker fx:id="pickupDatePicker" maxWidth="Infinity" prefHeight="48" style="-fx-background-color:#1E293B;                                            -fx-control-inner-background:#1E293B;                                            -fx-background-radius:10;                                            -fx-border-radius:10;                                            -fx-border-color:#334155;" />
                    </VBox>

                    <!-- Estimated Cost -->

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Estimated Cost" />

                        <TextField fx:id="costField" editable="false" prefHeight="48" promptText="Auto Calculated" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:#4F46E5;                                           -fx-font-weight:bold;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

                <!-- Instructions -->

                <VBox spacing="6">

                    <Label style="-fx-text-fill:#CBD5E1;" text="Special Instructions" />

                    <TextArea fx:id="notesArea" prefHeight="130" promptText="Add special washing or delivery instructions..." style="-fx-control-inner-background:#1E293B;                                      -fx-background-color:#1E293B;                                      -fx-text-fill:white;                                      -fx-prompt-text-fill:#64748B;                                      -fx-background-radius:10;                                      -fx-border-radius:10;                                      -fx-border-color:#334155;" wrapText="true" />

                </VBox>

                <!-- Buttons -->

                <HBox spacing="15">

                    <Button fx:id="createOrderBtn" prefHeight="50" prefWidth="180" style="-fx-background-color:#4F46E5;                                    -fx-text-fill:white;                                    -fx-font-size:14px;                                    -fx-font-weight:bold;                                    -fx-background-radius:12;" text="Create Order" />

                    <Button fx:id="clearBtn" prefHeight="50" prefWidth="140" style="-fx-background-color:#1E293B;                                    -fx-text-fill:white;                                    -fx-border-color:#334155;                                    -fx-border-radius:12;                                    -fx-background-radius:12;" text="Clear Form" />

                </HBox>

            </VBox>

        </VBox>

    </children>

</AnchorPane>
