<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.NewOrderController"
            prefHeight="800.0"
            prefWidth="1200.0"
            style="-fx-background-color:#0B1120;">

    <children>

        <VBox spacing="25"
              AnchorPane.topAnchor="30.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.bottomAnchor="30.0">

            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT"
                  spacing="15">

                <VBox spacing="5">

                    <Label text="Create New Order"
                           style="-fx-text-fill:white;
                                  -fx-font-size:30px;
                                  -fx-font-weight:bold;" />

                    <Label text="Fill in the details below to create a laundry order"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;" />

                </VBox>

                <Button fx:id="dashboardBtn"
                        text="🏠 Dashboard"
                        onAction="#goDashboard"
                        prefHeight="42"
                        prefWidth="140"
                        style="-fx-background-color:#2563EB;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-cursor:hand;" />

            </HBox>

            <!-- FORM CARD -->

            <VBox spacing="22"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:20;
                         -fx-padding:30;">

                <Label text="Order Information"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;" />

                <GridPane hgap="20"
                          vgap="18">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>

                    <!-- Customer Name -->

                    <VBox spacing="6"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0">

                        <Label text="Customer Name"
                               style="-fx-text-fill:#CBD5E1;" />

                        <TextField fx:id="nameField"
                                   prefHeight="48"
                                   promptText="Enter customer name"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;" />

                    </VBox>

                    <!-- Phone -->

                    <VBox spacing="6"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0">

                        <Label text="Phone Number"
                               style="-fx-text-fill:#CBD5E1;" />

                        <TextField fx:id="phoneField"
                                   prefHeight="48"
                                   promptText="01XXXXXXXXX"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;" />

                    </VBox>

                    <!-- Service -->

                    <VBox spacing="6"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <Label text="Service Type"
                               style="-fx-text-fill:#CBD5E1;" />

                        <ComboBox fx:id="serviceBox"
                                  onAction="#calculateCost"
                                  maxWidth="Infinity"
                                  prefHeight="48"
                                  promptText="Select Service"
                                  style="-fx-background-color:#1E293B;
                                         -fx-control-inner-background:#1E293B;
                                         -fx-background-radius:10;
                                         -fx-border-radius:10;
                                         -fx-border-color:#334155;" />

                    </VBox>

                    <!-- Quantity -->

                    <VBox spacing="6"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1">

                        <Label text="Quantity"
                               style="-fx-text-fill:#CBD5E1;" />

                        <TextField fx:id="quantityField"
                                   onKeyReleased="#calculateCost"
                                   prefHeight="48"
                                   promptText="Number of items"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;" />

                    </VBox>

                    <!-- Pickup Date -->

                    <VBox spacing="6"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="2">

                        <Label text="Pickup Date"
                               style="-fx-text-fill:#CBD5E1;" />

                        <DatePicker fx:id="pickupDatePicker"
                                    maxWidth="Infinity"
                                    prefHeight="48"
                                    style="-fx-background-color:#1E293B;
                                           -fx-control-inner-background:#1E293B;
                                           -fx-background-radius:10;
                                           -fx-border-radius:10;
                                           -fx-border-color:#334155;" />

                    </VBox>

                    <!-- Estimated Cost -->

                    <VBox spacing="6"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2">

                        <Label text="Estimated Cost"
                               style="-fx-text-fill:#CBD5E1;" />

                        <TextField fx:id="costField"
                                   editable="false"
                                   prefHeight="48"
                                   promptText="Auto Calculated"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:#4F46E5;
                                          -fx-font-weight:bold;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;" />

                    </VBox>

                </GridPane>

                <!-- NOTES -->

                <VBox spacing="6">

                    <Label text="Special Instructions"
                           style="-fx-text-fill:#CBD5E1;" />

                    <TextArea fx:id="notesArea"
                              prefHeight="130"
                              wrapText="true"
                              promptText="Add special washing or delivery instructions..."
                              style="-fx-control-inner-background:#1E293B;
                                     -fx-background-color:#1E293B;
                                     -fx-text-fill:white;
                                     -fx-prompt-text-fill:#64748B;
                                     -fx-background-radius:10;
                                     -fx-border-radius:10;
                                     -fx-border-color:#334155;" />

                </VBox>

                <!-- BUTTONS -->

                <HBox spacing="15">

                    <Button fx:id="createOrderBtn"
                            text="Create Order"
                            onAction="#createOrder"
                            prefHeight="50"
                            prefWidth="180"
                            style="-fx-background-color:#4F46E5;
                                   -fx-text-fill:white;
                                   -fx-font-size:14px;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:12;" />

                    <Button fx:id="clearBtn"
                            text="Clear Form"
                            onAction="#clearForm"
                            prefHeight="50"
                            prefWidth="140"
                            style="-fx-background-color:#1E293B;
                                   -fx-text-fill:white;
                                   -fx-border-color:#334155;
                                   -fx-border-radius:12;
                                   -fx-background-radius:12;" />

                </HBox>

            </VBox>

        </VBox>

    </children>

</AnchorPane>