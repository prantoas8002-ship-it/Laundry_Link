<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.ColumnConstraints?>
        <?import javafx.scene.layout.GridPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.RowConstraints?>
        <?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1200.0"
            style="-fx-background-color:#0B1120;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BillingController">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Header -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label text="Billing Management"
                           style="-fx-text-fill:white;
                                  -fx-font-size:30px;
                                  -fx-font-weight:bold;"/>

                    <Label text="Generate and manage customer bills"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;"/>

                </VBox>

                <Button fx:id="dashboardBtn"
                        text="🏠 Dashboard"
                        onAction="#goToDashboard"
                        prefHeight="42"
                        prefWidth="140"
                        style="-fx-background-color:#2563EB;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-cursor:hand;"/>

            </HBox>

            <!-- Billing Form -->

            <VBox spacing="18"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:25;">

                <Label text="Billing Information"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;"/>

                <GridPane hgap="20" vgap="15">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints/>
                        <RowConstraints/>
                        <RowConstraints/>
                    </rowConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">

                        <Label text="Order ID"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="orderIdField"
                                   prefHeight="45"
                                   promptText="Enter Order ID"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">

                        <Label text="Customer Name"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="customerField"
                                   prefHeight="45"
                                   promptText="Customer Name"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">

                        <Label text="Service Type"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="serviceField"
                                   prefHeight="45"
                                   promptText="Service Type"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">

                        <Label text="Quantity"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="quantityField"
                                   prefHeight="45"
                                   promptText="Quantity"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">

                        <Label text="Unit Price"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="unitPriceField"
                                   prefHeight="45"
                                   promptText="Price per item"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:white;
                                          -fx-prompt-text-fill:#64748B;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">

                        <Label text="Total Amount"
                               style="-fx-text-fill:#CBD5E1;"/>

                        <TextField fx:id="totalAmountField"
                                   editable="false"
                                   prefHeight="45"
                                   promptText="Auto Calculated"
                                   style="-fx-background-color:#1E293B;
                                          -fx-control-inner-background:#1E293B;
                                          -fx-text-fill:#10B981;
                                          -fx-font-weight:bold;
                                          -fx-background-radius:10;
                                          -fx-border-radius:10;
                                          -fx-border-color:#334155;"/>

                    </VBox>

                </GridPane>

                <HBox spacing="15">

                    <Button fx:id="calculateBtn"
                            text="Calculate Bill"
                            onAction="#calculateBill"
                            prefHeight="45"
                            prefWidth="150"
                            style="-fx-background-color:#4F46E5;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:10;"/>

                    <Button fx:id="saveBillBtn"
                            text="Save Bill"
                            onAction="#saveBill"
                            prefHeight="45"
                            prefWidth="130"
                            style="-fx-background-color:#10B981;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:10;"/>

                    <Button fx:id="printBillBtn"
                            text="Print Bill"
                            onAction="#printBill"
                            prefHeight="45"
                            prefWidth="130"
                            style="-fx-background-color:#F59E0B;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:10;"/>

                </HBox>

            </VBox>

            <!-- Billing Records -->

            <VBox spacing="15"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;"
                  VBox.vgrow="ALWAYS">

                <Label text="Billing Records"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;"/>

                <TableView fx:id="billingTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="billIdCol" text="Bill ID"/>
                        <TableColumn fx:id="orderIdCol" text="Order ID"/>
                        <TableColumn fx:id="customerCol" text="Customer"/>
                        <TableColumn fx:id="serviceCol" text="Service"/>
                        <TableColumn fx:id="amountCol" text="Amount"/>
                        <TableColumn fx:id="dateCol" text="Date"/>
                        <TableColumn fx:id="statusCol" text="Payment Status"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>

