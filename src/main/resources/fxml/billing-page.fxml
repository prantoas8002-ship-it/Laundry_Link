<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color:#0B1120;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- Header -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label style="-fx-text-fill:white;                                   -fx-font-size:30px;                                   -fx-font-weight:bold;" text="Billing Management" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-size:14px;" text="Generate and manage customer bills" />

                </VBox>

                <Button fx:id="dashboardBtn" prefHeight="42" prefWidth="140" style="-fx-background-color:#2563EB;                                -fx-text-fill:white;                                -fx-font-size:14px;                                -fx-font-weight:bold;                                -fx-background-radius:10;                                -fx-cursor:hand;" text="🏠 Dashboard" />

            </HBox>

            <!-- Billing Form -->

            <VBox spacing="18" style="-fx-background-color:#111827;                          -fx-background-radius:18;                          -fx-padding:25;">

                <Label style="-fx-text-fill:white;                               -fx-font-size:18px;                               -fx-font-weight:bold;" text="Billing Information" />

                <GridPane hgap="20" vgap="15">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Order ID" />

                        <TextField fx:id="orderIdField" prefHeight="45" promptText="Enter Order ID" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Customer Name" />

                        <TextField fx:id="customerField" prefHeight="45" promptText="Customer Name" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Service Type" />

                        <TextField fx:id="serviceField" prefHeight="45" promptText="Service Type" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Quantity" />

                        <TextField fx:id="quantityField" prefHeight="45" promptText="Quantity" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Unit Price" />

                        <TextField fx:id="unitPriceField" prefHeight="45" promptText="Price per item" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#64748B;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">

                        <Label style="-fx-text-fill:#CBD5E1;" text="Total Amount" />

                        <TextField fx:id="totalAmountField" editable="false" prefHeight="45" promptText="Auto Calculated" style="-fx-background-color:#1E293B;                                           -fx-control-inner-background:#1E293B;                                           -fx-text-fill:#10B981;                                           -fx-font-weight:bold;                                           -fx-background-radius:10;                                           -fx-border-radius:10;                                           -fx-border-color:#334155;" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>

                <HBox spacing="15">

                    <Button fx:id="calculateBtn" prefHeight="45" prefWidth="150" style="-fx-background-color:#4F46E5;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;                                    -fx-background-radius:10;" text="Calculate Bill" />

                    <Button fx:id="saveBillBtn" prefHeight="45" prefWidth="130" style="-fx-background-color:#10B981;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;                                    -fx-background-radius:10;" text="Save Bill" />

                    <Button fx:id="printBillBtn" prefHeight="45" prefWidth="130" style="-fx-background-color:#F59E0B;                                    -fx-text-fill:white;                                    -fx-font-weight:bold;                                    -fx-background-radius:10;" text="Print Bill" />

                </HBox>

            </VBox>

            <!-- Bills Table -->

            <VBox spacing="15" style="-fx-background-color:#111827;                          -fx-background-radius:18;                          -fx-padding:20;" VBox.vgrow="ALWAYS">

                <Label style="-fx-text-fill:white;                               -fx-font-size:18px;                               -fx-font-weight:bold;" text="Billing Records" />

                <TableView fx:id="billingTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="billIdCol" prefWidth="100" text="Bill ID" />
                        <TableColumn fx:id="orderIdCol" prefWidth="120" text="Order ID" />
                        <TableColumn fx:id="customerCol" prefWidth="180" text="Customer" />
                        <TableColumn fx:id="serviceCol" prefWidth="180" text="Service" />
                        <TableColumn fx:id="amountCol" prefWidth="120" text="Amount" />
                        <TableColumn fx:id="dateCol" prefWidth="150" text="Date" />
                        <TableColumn fx:id="statusCol" prefWidth="150" text="Payment Status" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>
