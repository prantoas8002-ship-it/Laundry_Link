<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #F5F8FC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ProfileController">

    <children>

        <!-- ================= SIDEBAR ================= -->

        <VBox prefWidth="270.0" spacing="8.0" style="-fx-background-color: #0B4F6C;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="30" left="20" right="20" top="35" />
            </padding>

            <!-- Logo -->

            <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="12">

                <Label style="-fx-text-fill: white;                               -fx-font-size: 25px;                               -fx-font-weight: bold;" text="  LaundryLink" />

            </HBox>


            <!-- Navigation -->

            <VBox spacing="8" VBox.vgrow="ALWAYS">

                <Button alignment="CENTER_LEFT" onAction="#goDashboard" prefHeight="50" prefWidth="230" style="-fx-background-color: transparent;                                -fx-text-fill: white;                                -fx-font-size: 15px;                                -fx-font-weight: bold;                                -fx-background-radius: 8;                                -fx-padding: 0 15 0 15;" text="⌂   Dashboard" />


                <!-- Active Profile -->

                <Button alignment="CENTER_LEFT" disable="true" prefHeight="50" prefWidth="230" style="-fx-background-color: #176B87;                                -fx-text-fill: white;                                -fx-font-size: 15px;                                -fx-font-weight: bold;                                -fx-background-radius: 8;                                -fx-opacity: 1;                                -fx-padding: 0 15 0 15;" text="👤   My Profile" />

            </VBox>


            <!-- Logout -->

            <Button alignment="CENTER_LEFT" onAction="#logout" prefHeight="50" prefWidth="230" style="-fx-background-color: #083B50;                            -fx-text-fill: white;                            -fx-font-size: 15px;                            -fx-background-radius: 8;                            -fx-padding: 0 15 0 15;" text="⇥   Logout" />

        </VBox>


        <!-- ================= MAIN CONTENT ================= -->

        <VBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="270.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="40" left="45" right="45" top="30" />
            </padding>


            <!-- Header -->

            <HBox alignment="CENTER_LEFT" prefHeight="65">

                <VBox spacing="4" HBox.hgrow="ALWAYS">

                    <Label style="-fx-font-size: 30px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #17324D;" text="My Profile" />

                    <Label style="-fx-font-size: 14px;                                   -fx-text-fill: #718096;" text="View your personal and account information" />

                </VBox>


                <Label style="-fx-background-color: #E8F4F8;                               -fx-text-fill: #0B4F6C;                               -fx-font-size: 13px;                               -fx-font-weight: bold;                               -fx-padding: 9 18 9 18;                               -fx-background-radius: 20;" text="CUSTOMER" />

            </HBox>


            <!-- Profile Content -->

            <HBox spacing="25" VBox.vgrow="ALWAYS">


                <!-- ================= LEFT PROFILE CARD ================= -->

                <VBox alignment="TOP_CENTER" prefWidth="350" spacing="18" style="-fx-background-color: white;                              -fx-background-radius: 14;                              -fx-border-radius: 14;                              -fx-border-color: #E3EAF0;">

                    <padding>
                        <Insets bottom="35" left="30" right="30" top="40" />
                    </padding>


                    <!-- Avatar -->

                    <VBox alignment="CENTER">

                        <Circle radius="55" style="-fx-fill: #E7F3F7;                                        -fx-stroke: #0B4F6C;                                        -fx-stroke-width: 2;" />

                        <Label style="-fx-font-size: 40px;" text="👤" translateY="-68" />

                    </VBox>


                    <!-- Customer Name -->

                    <Label style="-fx-font-size: 22px;                                   -fx-font-weight: bold;                                   -fx-text-fill: #17324D;" text="Customer" />

                    <Label style="-fx-font-size: 14px;                                   -fx-text-fill: #718096;" text="LaundryLink Customer" />


                    <!-- Status -->

                    <HBox alignment="CENTER" spacing="8">

                        <Circle radius="5" style="-fx-fill: #27AE60;" />

                        <Label style="-fx-text-fill: #27AE60;                                       -fx-font-size: 13px;                                       -fx-font-weight: bold;" text="Active Account" />

                    </HBox>

                </VBox>


                <!-- ================= RIGHT SIDE ================= -->

                <VBox spacing="20" HBox.hgrow="ALWAYS">


                    <!-- Personal Information -->

                    <VBox spacing="20" style="-fx-background-color: white;                                  -fx-background-radius: 14;                                  -fx-border-radius: 14;                                  -fx-border-color: #E3EAF0;">

                        <padding>
                            <Insets bottom="30" left="30" right="30" top="28" />
                        </padding>


                        <VBox spacing="4">

                            <Label style="-fx-font-size: 20px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #17324D;" text="Personal Information" />

                            <Label style="-fx-font-size: 13px;                                           -fx-text-fill: #718096;" text="Your registered customer information" />

                        </VBox>


                        <!-- Name + Phone -->

                        <HBox spacing="20">

                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="FULL NAME" />

                                <Label fx:id="nameLabel" maxWidth="Infinity" prefHeight="45" style="-fx-background-color: #F7F9FB;                                               -fx-background-radius: 8;                                               -fx-padding: 0 15 0 15;                                               -fx-font-size: 15px;                                               -fx-text-fill: #27394D;" text="Loading..." />

                            </VBox>


                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="PHONE NUMBER" />

                                <Label fx:id="phoneLabel" maxWidth="Infinity" prefHeight="45" style="-fx-background-color: #F7F9FB;                                               -fx-background-radius: 8;                                               -fx-padding: 0 15 0 15;                                               -fx-font-size: 15px;                                               -fx-text-fill: #27394D;" text="Loading..." />

                            </VBox>

                        </HBox>


                        <!-- Email + Username -->

                        <HBox spacing="20">

                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="EMAIL ADDRESS" />

                                <Label fx:id="emailLabel" maxWidth="Infinity" prefHeight="45" style="-fx-background-color: #F7F9FB;                                               -fx-background-radius: 8;                                               -fx-padding: 0 15 0 15;                                               -fx-font-size: 15px;                                               -fx-text-fill: #27394D;" text="Loading..." />

                            </VBox>


                            <VBox spacing="7" HBox.hgrow="ALWAYS">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="USERNAME" />

                                <Label fx:id="usernameLabel" maxWidth="Infinity" prefHeight="45" style="-fx-background-color: #F7F9FB;                                               -fx-background-radius: 8;                                               -fx-padding: 0 15 0 15;                                               -fx-font-size: 15px;                                               -fx-text-fill: #27394D;" text="Loading..." />

                            </VBox>

                        </HBox>


                        <!-- Address -->

                        <VBox spacing="7">

                            <Label style="-fx-font-size: 11px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #8A98A8;" text="ADDRESS" />

                            <Label fx:id="addressLabel" maxWidth="Infinity" prefHeight="65" style="-fx-background-color: #F7F9FB;                                           -fx-background-radius: 8;                                           -fx-padding: 15;                                           -fx-font-size: 15px;                                           -fx-text-fill: #27394D;" text="Loading..." wrapText="true" />

                        </VBox>

                    </VBox>


                    <!-- Account Information -->

                    <VBox spacing="18" style="-fx-background-color: white;                                  -fx-background-radius: 14;                                  -fx-border-radius: 14;                                  -fx-border-color: #E3EAF0;">

                        <padding>
                            <Insets bottom="25" left="30" right="30" top="25" />
                        </padding>


                        <Label style="-fx-font-size: 19px;                                       -fx-font-weight: bold;                                       -fx-text-fill: #17324D;" text="Account Information" />


                        <HBox spacing="80">

                            <VBox spacing="5">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="ACCOUNT TYPE" />

                                <Label fx:id="roleLabel" style="-fx-font-size: 15px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #0B4F6C;" text="CUSTOMER" />

                            </VBox>


                            <VBox spacing="5">

                                <Label style="-fx-font-size: 11px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #8A98A8;" text="ACCOUNT STATUS" />

                                <Label style="-fx-font-size: 15px;                                               -fx-font-weight: bold;                                               -fx-text-fill: #27AE60;" text="Active" />

                            </VBox>

                        </HBox>

                    </VBox>

                </VBox>

            </HBox>

        </VBox>

    </children>

</AnchorPane>
