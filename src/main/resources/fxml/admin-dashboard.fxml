<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>

<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml"
            style="-fx-background-color: #020617;">
    <left>
        <VBox prefWidth="250"
              spacing="10"
              style="-fx-background-color: #0F172A; -fx-padding: 20;">

            <Label text="LaundryLink"
                   style="-fx-text-fill: white;
                      -fx-font-size: 24;
                      -fx-font-weight: bold;" />

            <Label text="Laundry Management System"
                   style="-fx-text-fill: #94A3B8;
                      -fx-font-size: 12;" />

            <Separator />

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #3B82F6;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 12;" />

            <Button text="Orders"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #CBD5E1;
                       -fx-font-weight: bold;" />

            <Button text="Customers"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #CBD5E1;
                       -fx-font-weight: bold;" />

            <Button text="Billing"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #CBD5E1;
                       -fx-font-weight: bold;" />

            <Button text="Inventory"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #CBD5E1;
                       -fx-font-weight: bold;" />

            <Button text="Reports"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: #CBD5E1;
                       -fx-font-weight: bold;" />

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #EF4444;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 12;" />

        </VBox>
    </left>

    <center>

        <VBox spacing="20"
              style="-fx-padding: 25;">

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">

                    <Label text="Admin Dashboard"
                           style="-fx-text-fill: white;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;" />

                    <Label text="Manage your laundry business efficiently"
                           style="-fx-text-fill: #94A3B8;" />

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField promptText="Search..."
                           prefWidth="250"
                           prefHeight="40"
                           style="-fx-background-radius: 12;" />

                <Label text="Admin"
                       style="-fx-text-fill: white;
                          -fx-font-size: 14;
                          -fx-padding: 0 0 0 15;" />

            </HBox>

            <GridPane hgap="20" vgap="20">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                    <Label text="Total Orders"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label text="1,245"
                           style="-fx-text-fill: white;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;" />

                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                    <Label text="Pending Orders"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label text="83"
                           style="-fx-text-fill: #F59E0B;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;" />

                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                    <Label text="Completed"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label text="1,162"
                           style="-fx-text-fill: #22C55E;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;" />

                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                    <Label text="Revenue"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label text="12,540"
                           style="-fx-text-fill: #38BDF8;
                              -fx-font-size: 30;
                              -fx-font-weight: bold;" />

                </VBox>

            </GridPane>

            <VBox VBox.vgrow="ALWAYS"
                  spacing="15"
                  style="-fx-background-color: #1E293B;
                     -fx-background-radius: 18;
                     -fx-padding: 20;">

                <HBox>

                    <Label text="Recent Orders"
                           style="-fx-text-fill: white;
                              -fx-font-size: 18;
                              -fx-font-weight: bold;" />

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="View All"
                            style="-fx-background-color: #3B82F6;
                               -fx-text-fill: white;" />

                </HBox>

                <TableView VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn text="Order ID"/>
                        <TableColumn text="Customer"/>
                        <TableColumn text="Service"/>
                        <TableColumn text="Status"/>
                        <TableColumn text="Amount"/>
                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>


</BorderPane>
