<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDashboardController"
            style="-fx-background-color: #020617;">

    <left>
        <VBox prefWidth="250"
              spacing="10"
              style="-fx-background-color: #0F172A; -fx-padding: 20;">

            <Label text="LaundryLink"
                   style="-fx-text-fill: white;
                          -fx-font-size: 24;
                          -fx-font-weight: bold;" />

            <Label text="Laundry Management System"
                   style="-fx-text-fill: #94A3B8;
                          -fx-font-size: 12;" />

            <Separator />

            <Button fx:id="dashboardBtn"
                    text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #3B82F6;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;" />

            <Button fx:id="ordersBtn"
                    text="Orders"
                    onAction="#openOrders"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #CBD5E1;
                           -fx-font-weight: bold;" />

            <Button fx:id="customersBtn"
                    text="Customers"
                    onAction="#openCustomers"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #CBD5E1;
                           -fx-font-weight: bold;" />

            <Button fx:id="billingBtn"
                    text="Billing"
                    onAction="#openBilling"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #CBD5E1;
                           -fx-font-weight: bold;" />

            <Button fx:id="inventoryBtn"
                    text="Inventory"
                    onAction="#openInventory"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #CBD5E1;
                           -fx-font-weight: bold;" />

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="logoutBtn"
                    text="Logout"
                    onAction="#logout"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #EF4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;" />

        </VBox>
    </left>

    <center>

        <VBox spacing="20"
              BorderPane.alignment="CENTER"
              style="-fx-padding: 25;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="5">

                    <Label text="Admin Dashboard"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 30;
                                  -fx-font-weight: bold;" />

                    <Label text="Manage your laundry business efficiently"
                           style="-fx-text-fill: #94A3B8;" />

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Search..."
                           onAction="#searchOrders"
                           prefWidth="250"
                           prefHeight="40"
                           style="-fx-background-radius: 12;" />

                <Label text="Admin"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14;
                              -fx-padding: 0 0 0 15;" />

            </HBox>


            <!-- STATISTICS -->
            <GridPane hgap="20" vgap="20">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>


                <!-- TOTAL ORDERS -->
                <VBox GridPane.columnIndex="0"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                             -fx-background-radius: 18;
                             -fx-padding: 20;">

                    <Label text="Total Orders"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label fx:id="totalOrdersLabel"
                           text="0"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 30;
                                  -fx-font-weight: bold;" />

                </VBox>


                <!-- PENDING ORDERS -->
                <VBox GridPane.columnIndex="1"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                             -fx-background-radius: 18;
                             -fx-padding: 20;">

                    <Label text="Pending Orders"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label fx:id="pendingOrdersLabel"
                           text="0"
                           style="-fx-text-fill: #F59E0B;
                                  -fx-font-size: 30;
                                  -fx-font-weight: bold;" />

                </VBox>


                <!-- COMPLETED -->
                <VBox GridPane.columnIndex="2"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                             -fx-background-radius: 18;
                             -fx-padding: 20;">

                    <Label text="Completed"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label fx:id="completedOrdersLabel"
                           text="0"
                           style="-fx-text-fill: #22C55E;
                                  -fx-font-size: 30;
                                  -fx-font-weight: bold;" />

                </VBox>


                <!-- REVENUE -->
                <VBox GridPane.columnIndex="3"
                      spacing="10"
                      style="-fx-background-color: #1E293B;
                             -fx-background-radius: 18;
                             -fx-padding: 20;">

                    <Label text="Revenue"
                           style="-fx-text-fill: #94A3B8;" />

                    <Label fx:id="revenueLabel"
                           text="0.00"
                           style="-fx-text-fill: #38BDF8;
                                  -fx-font-size: 30;
                                  -fx-font-weight: bold;" />

                </VBox>

            </GridPane>


            <!-- RECENT ORDERS -->
            <VBox VBox.vgrow="ALWAYS"
                  spacing="15"
                  style="-fx-background-color: #1E293B;
                         -fx-background-radius: 18;
                         -fx-padding: 20;">

                <HBox>

                    <Label text="Recent Orders"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 18;
                                  -fx-font-weight: bold;" />

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="View All"
                            onAction="#viewAllOrders"
                            style="-fx-background-color: #3B82F6;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;" />

                </HBox>


                <TableView fx:id="ordersTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <!-- IMPORTANT: fx:id added -->

                        <TableColumn fx:id="orderIdColumn"
                                     text="Order ID"
                                     prefWidth="120" />

                        <TableColumn fx:id="customerColumn"
                                     text="Customer"
                                     prefWidth="220" />

                        <TableColumn fx:id="serviceColumn"
                                     text="Service"
                                     prefWidth="220" />

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="180" />

                        <TableColumn fx:id="amountColumn"
                                     text="Amount"
                                     prefWidth="150" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>