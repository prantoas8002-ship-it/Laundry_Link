<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.CheckBox?>
        <?import javafx.scene.control.Hyperlink?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>

<StackPane
        style="-fx-background-color: linear-gradient(to bottom right, #0F172A, #1E293B);"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.LoginController">

    <VBox alignment="CENTER" fillWidth="false" spacing="25">

        <!-- Logo -->
        <Label
                style="-fx-font-size: 36px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;"
                text="LaundryLink" />

        <Label
                style="-fx-font-size: 15px;
                       -fx-text-fill: #CBD5E1;"
                text="Smart Laundry Management System" />

        <!-- Login Card -->
        <VBox
                alignment="CENTER"
                maxWidth="400"
                prefWidth="380"
                spacing="18"
                style="-fx-background-color: rgba(255,255,255,0.08);
                       -fx-background-radius: 20;
                       -fx-border-color: rgba(255,255,255,0.15);
                       -fx-border-radius: 20;
                       -fx-padding: 35;">

            <Label
                    style="-fx-font-size: 26px;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"
                    text="Login" />

            <TextField
                    fx:id="usernameField"
                    maxWidth="300"
                    prefHeight="42"
                    promptText="Username"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />

            <PasswordField
                    fx:id="passwordField"
                    maxWidth="300"
                    prefHeight="42"
                    promptText="Password"
                    style="-fx-background-radius: 10;
                           -fx-font-size: 14px;" />

            <CheckBox
                    style="-fx-text-fill: white;"
                    text="Remember Me" />

            <Button
                    maxWidth="300"
                    onAction="#login"
                    prefHeight="45"
                    style="-fx-background-color: #38BDF8;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;"
                    text="SIGN IN" />

            <Hyperlink
                    style="-fx-text-fill: #93C5FD;"
                    text="Forgot Password?" />

            <!-- Register -->
            <Label
                    style="-fx-text-fill: #94A3B8;"
                    text="Don't have an account?" />

            <Hyperlink
                    onAction="#openRegister"
                    style="-fx-text-fill: #38BDF8;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;"
                    text="Create Customer Account" />

        </VBox>

        <!-- Footer -->
        <Label
                style="-fx-text-fill: #94A3B8;"
                text="© 2026 LaundryLink" />

    </VBox>

</StackPane>
