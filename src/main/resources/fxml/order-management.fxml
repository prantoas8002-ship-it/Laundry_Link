<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1200.0"
            style="-fx-background-color:#0B1120;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OrderManagementController">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets bottom="25"
                        left="25"
                        right="25"
                        top="25" />
            </padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT"
                  spacing="15">

                <VBox spacing="5">

                    <Label text="Order Management"
                           style="-fx-text-fill:white;
                                  -fx-font-size:30px;
                                  -fx-font-weight:bold;" />

                    <Label text="Manage laundry orders efficiently"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;" />

                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="dashboardBtn"
                        onAction="#goDashboard"
                        prefHeight="42"
                        prefWidth="140"
                        text="🏠 Dashboard"
                        style="-fx-background-color:#2563EB;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;" />

            </HBox>


            <!-- Toolbar -->
            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;">

                <Button fx:id="addBtn"
                        onAction="#addOrder"
                        prefHeight="45"
                        prefWidth="140"
                        text="+ Add Order"
                        style="-fx-background-color:#4F46E5;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;" />

                <Button fx:id="updateBtn"
                        onAction="#updateOrder"
                        prefHeight="45"
                        prefWidth="120"
                        text="✏ Update"
                        style="-fx-background-color:#10B981;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;" />

                <Button fx:id="deleteBtn"
                        onAction="#deleteOrder"
                        prefHeight="45"
                        prefWidth="120"
                        text="🗑 Delete"
                        style="-fx-background-color:#EF4444;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;" />

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField"
                           prefHeight="45"
                           prefWidth="250"
                           promptText="Search by ID or Customer..."
                           style="-fx-background-color:#1E293B;
                                  -fx-control-inner-background:#1E293B;
                                  -fx-text-fill:white;
                                  -fx-prompt-text-fill:#64748B;
                                  -fx-background-radius:10;
                                  -fx-border-radius:10;
                                  -fx-border-color:#334155;" />

                <Button fx:id="searchBtn"
                        onAction="#searchOrder"
                        prefHeight="45"
                        prefWidth="120"
                        text="🔍 Search"
                        style="-fx-background-color:#F59E0B;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;" />

            </HBox>


            <!-- Table Section -->
            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;">

                <Label text="Orders List"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;" />


                <TableView fx:id="ordersTable"
                           editable="false"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="orderIdCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Order ID" />

                        <TableColumn fx:id="customerCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Customer" />

                        <TableColumn fx:id="serviceCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Service" />

                        <TableColumn fx:id="quantityCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Quantity" />

                        <TableColumn fx:id="statusCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Status" />

                        <TableColumn fx:id="costCol"
                                     resizable="false"
                                     sortable="false"
                                     text="Cost" />

                    </columns>

                </TableView>


                <!-- Status Management -->
                <HBox alignment="CENTER_LEFT"
                      spacing="12"
                      style="-fx-background-color:#1E293B;
                             -fx-background-radius:12;
                             -fx-padding:15;">

                    <Label text="Selected Order:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;" />

                    <Label fx:id="selectedOrderLabel"
                           text="None"
                           style="-fx-text-fill:white;
                                  -fx-font-size:15px;
                                  -fx-font-weight:bold;" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="Change Status:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;" />

                    <ComboBox fx:id="statusBox"
                              prefHeight="40"
                              prefWidth="170"
                              promptText="Select Status"
                              style="-fx-background-color:#0F172A;
                                     -fx-text-fill:white;
                                     -fx-background-radius:8;" />

                    <Button fx:id="statusUpdateBtn"
                            onAction="#updateStatus"
                            prefHeight="40"
                            prefWidth="145"
                            text="✓ Update Status"
                            style="-fx-background-color:#8B5CF6;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:8;" />

                </HBox>


                <!-- Footer -->
                <HBox alignment="CENTER_LEFT"
                      spacing="20">

                    <Label text="Total Orders:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;" />

                    <Label fx:id="totalOrdersLabel"
                           text="0"
                           style="-fx-text-fill:white;
                                  -fx-font-size:16px;
                                  -fx-font-weight:bold;" />

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>