<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1200.0"
            style="-fx-background-color:#0B1120;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CustomerHistoryController">

    <center>

        <VBox spacing="18">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label text="Customer History"
                           style="-fx-text-fill:white;
                                  -fx-font-size:30px;
                                  -fx-font-weight:bold;"/>

                    <Label text="View customer information and individual order history"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="dashboardBtn"
                        text="🏠 Dashboard"
                        onAction="#goToDashboard"
                        prefHeight="42"
                        prefWidth="140"
                        style="-fx-background-color:#2563EB;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-cursor:hand;"/>

            </HBox>


            <!-- SEARCH -->

            <HBox alignment="CENTER_LEFT"
                  spacing="15"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;">

                <TextField fx:id="searchField"
                           prefHeight="45"
                           prefWidth="320"
                           promptText="Search Customer ID or Name..."
                           style="-fx-background-color:#1E293B;
                                  -fx-control-inner-background:#1E293B;
                                  -fx-text-fill:white;
                                  -fx-prompt-text-fill:#64748B;
                                  -fx-background-radius:10;
                                  -fx-border-radius:10;
                                  -fx-border-color:#334155;"/>

                <Button fx:id="searchBtn"
                        text="🔍 Search"
                        onAction="#searchCustomer"
                        prefHeight="45"
                        prefWidth="120"
                        style="-fx-background-color:#4F46E5;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;"/>

                <Button text="Clear"
                        onAction="#clearSearch"
                        prefHeight="45"
                        prefWidth="90"
                        style="-fx-background-color:#334155;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Total Customers:"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-weight:bold;"/>

                <Label fx:id="totalCustomersLabel"
                       text="0"
                       style="-fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;"/>

            </HBox>


            <!-- CUSTOMER SUMMARY -->

            <VBox spacing="12"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;"
                  VBox.vgrow="ALWAYS">

                <Label text="Customer Summary"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;"/>

                <Label text="Select a customer to view their order history"
                       style="-fx-text-fill:#64748B;
                              -fx-font-size:13px;"/>

                <TableView fx:id="customerTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="customerIdCol"
                                     text="Customer ID"/>

                        <TableColumn fx:id="customerNameCol"
                                     text="Customer Name"/>

                        <TableColumn fx:id="phoneCol"
                                     text="Phone"/>

                        <TableColumn fx:id="emailCol"
                                     text="Email"/>

                        <TableColumn fx:id="totalOrdersCol"
                                     text="Total Orders"/>

                        <TableColumn fx:id="totalSpentCol"
                                     text="Total Spent"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- SELECTED CUSTOMER INFO -->

            <HBox alignment="CENTER_LEFT"
                  spacing="25"
                  style="-fx-background-color:#1E293B;
                         -fx-background-radius:12;
                         -fx-padding:15;">

                <Label text="Selected Customer:"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-weight:bold;"/>

                <Label fx:id="selectedCustomerLabel"
                       text="None"
                       style="-fx-text-fill:white;
                              -fx-font-weight:bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Total Orders:"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-weight:bold;"/>

                <Label fx:id="selectedTotalOrdersLabel"
                       text="0"
                       style="-fx-text-fill:white;
                              -fx-font-weight:bold;"/>

                <Label text="Total Spent:"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-weight:bold;"/>

                <Label fx:id="selectedTotalSpentLabel"
                       text="৳0"
                       style="-fx-text-fill:#10B981;
                              -fx-font-weight:bold;"/>

            </HBox>


            <!-- ORDER HISTORY -->

            <VBox spacing="12"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;"
                  VBox.vgrow="ALWAYS">

                <Label text="Selected Customer's Order History"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;"/>

                <Label fx:id="orderHistoryHintLabel"
                       text="Select a customer above"
                       style="-fx-text-fill:#64748B;
                              -fx-font-size:13px;"/>

                <TableView fx:id="orderHistoryTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="orderIdCol"
                                     text="Order ID"/>

                        <TableColumn fx:id="serviceCol"
                                     text="Service"/>

                        <TableColumn fx:id="quantityCol"
                                     text="Quantity"/>

                        <TableColumn fx:id="amountCol"
                                     text="Amount"/>

                        <TableColumn fx:id="dateCol"
                                     text="Order Date"/>

                        <TableColumn fx:id="statusCol"
                                     text="Status"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>