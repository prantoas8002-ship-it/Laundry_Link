<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color:#0B1120;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- Header -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label style="-fx-text-fill:white;                                   -fx-font-size:30px;                                   -fx-font-weight:bold;" text="Customer History" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-size:14px;" text="View customer order history and activity records" />

                </VBox>

                <Button fx:id="dashboardBtn" prefHeight="42" prefWidth="140" style="-fx-background-color:#2563EB;                                -fx-text-fill:white;                                -fx-font-size:14px;                                -fx-font-weight:bold;                                -fx-background-radius:10;                                -fx-cursor:hand;" text="🏠 Dashboard" />

            </HBox>

            <!-- Search Section -->

            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color:#111827;                          -fx-background-radius:18;                          -fx-padding:20;">

                <TextField fx:id="searchField" prefHeight="45" prefWidth="300" promptText="Search Customer ID or Name..." style="-fx-background-color:#1E293B;                                   -fx-control-inner-background:#1E293B;                                   -fx-text-fill:white;                                   -fx-prompt-text-fill:#64748B;                                   -fx-background-radius:10;                                   -fx-border-radius:10;                                   -fx-border-color:#334155;" />

                <Button fx:id="searchBtn" prefHeight="45" prefWidth="120" style="-fx-background-color:#4F46E5;                                -fx-text-fill:white;                                -fx-font-weight:bold;                                -fx-background-radius:10;" text="🔍 Search" />

                <Region HBox.hgrow="ALWAYS" />

                <Label style="-fx-text-fill:#94A3B8;                               -fx-font-weight:bold;" text="Total Customers:" />

                <Label fx:id="totalCustomersLabel" style="-fx-text-fill:white;                               -fx-font-size:16px;                               -fx-font-weight:bold;" text="0" />

            </HBox>

            <!-- Customer History Table -->

            <VBox spacing="15" style="-fx-background-color:#111827;                          -fx-background-radius:18;                          -fx-padding:20;" VBox.vgrow="ALWAYS">

                <Label style="-fx-text-fill:white;                               -fx-font-size:18px;                               -fx-font-weight:bold;" text="History Records" />

                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="customerIdCol" prefWidth="120" text="Customer ID" />

                        <TableColumn fx:id="customerNameCol" prefWidth="180" text="Customer Name" />

                        <TableColumn fx:id="orderIdCol" prefWidth="120" text="Order ID" />

                        <TableColumn fx:id="serviceCol" prefWidth="180" text="Service" />

                        <TableColumn fx:id="quantityCol" prefWidth="100" text="Quantity" />

                        <TableColumn fx:id="amountCol" prefWidth="120" text="Amount" />

                        <TableColumn fx:id="dateCol" prefWidth="150" text="Order Date" />

                        <TableColumn fx:id="statusCol" prefWidth="150" text="Status" />

                    </columns>

                </TableView>

                <!-- Summary Card -->

                <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-background-color:#1E293B;                              -fx-background-radius:12;                              -fx-padding:15;">

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-weight:bold;" text="Selected Customer:" />

                    <Label fx:id="selectedCustomerLabel" style="-fx-text-fill:white;                                   -fx-font-weight:bold;" text="None" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-weight:bold;" text="Total Orders:" />

                    <Label fx:id="totalOrdersLabel" style="-fx-text-fill:white;                                   -fx-font-weight:bold;" text="0" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-weight:bold;" text="Total Spent:" />

                    <Label fx:id="totalSpentLabel" style="-fx-text-fill:#10B981;                                   -fx-font-weight:bold;" text="৳0" />

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>
