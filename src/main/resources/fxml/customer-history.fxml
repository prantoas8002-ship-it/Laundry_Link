<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.Region?>
        <?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0"
            prefWidth="1200.0"
            style="-fx-background-color:#0B1120;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.CustomerHistoryController">

    <center>

        <VBox spacing="20">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Header -->

            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5">

                    <Label text="Customer History"
                           style="-fx-text-fill:white;
                                  -fx-font-size:30px;
                                  -fx-font-weight:bold;"/>

                    <Label text="View customer order history and activity records"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;"/>

                </VBox>

                <Button fx:id="dashboardBtn"
                        text="🏠 Dashboard"
                        onAction="#goToDashboard"
                        prefHeight="42"
                        prefWidth="140"
                        style="-fx-background-color:#2563EB;
                               -fx-text-fill:white;
                               -fx-font-size:14px;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;
                               -fx-cursor:hand;"/>

            </HBox>

            <!-- Search Section -->

            <HBox alignment="CENTER_LEFT"
                  spacing="15"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;">

                <TextField fx:id="searchField"
                           prefHeight="45"
                           prefWidth="300"
                           promptText="Search Customer ID or Name..."
                           style="-fx-background-color:#1E293B;
                                  -fx-control-inner-background:#1E293B;
                                  -fx-text-fill:white;
                                  -fx-prompt-text-fill:#64748B;
                                  -fx-background-radius:10;
                                  -fx-border-radius:10;
                                  -fx-border-color:#334155;"/>

                <Button fx:id="searchBtn"
                        text="🔍 Search"
                        onAction="#searchCustomer"
                        prefHeight="45"
                        prefWidth="120"
                        style="-fx-background-color:#4F46E5;
                               -fx-text-fill:white;
                               -fx-font-weight:bold;
                               -fx-background-radius:10;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Total Customers:"
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-weight:bold;"/>

                <Label fx:id="totalCustomersLabel"
                       text="0"
                       style="-fx-text-fill:white;
                              -fx-font-size:16px;
                              -fx-font-weight:bold;"/>

            </HBox>

            <!-- Customer History Table -->

            <VBox spacing="15"
                  style="-fx-background-color:#111827;
                         -fx-background-radius:18;
                         -fx-padding:20;"
                  VBox.vgrow="ALWAYS">

                <Label text="History Records"
                       style="-fx-text-fill:white;
                              -fx-font-size:18px;
                              -fx-font-weight:bold;"/>

                <TableView fx:id="historyTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="customerIdCol"
                                     text="Customer ID"/>

                        <TableColumn fx:id="customerNameCol"
                                     text="Customer Name"/>

                        <TableColumn fx:id="orderIdCol"
                                     text="Order ID"/>

                        <TableColumn fx:id="serviceCol"
                                     text="Service"/>

                        <TableColumn fx:id="quantityCol"
                                     text="Quantity"/>

                        <TableColumn fx:id="amountCol"
                                     text="Amount"/>

                        <TableColumn fx:id="dateCol"
                                     text="Order Date"/>

                        <TableColumn fx:id="statusCol"
                                     text="Status"/>

                    </columns>

                </TableView>

                <!-- Summary Card -->

                <HBox alignment="CENTER_LEFT"
                      spacing="25"
                      style="-fx-background-color:#1E293B;
                             -fx-background-radius:12;
                             -fx-padding:15;">

                    <Label text="Selected Customer:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="selectedCustomerLabel"
                           text="None"
                           style="-fx-text-fill:white;
                                  -fx-font-weight:bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Total Orders:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="totalOrdersLabel"
                           text="0"
                           style="-fx-text-fill:white;
                                  -fx-font-weight:bold;"/>

                    <Label text="Total Spent:"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="totalSpentLabel"
                           text="৳0"
                           style="-fx-text-fill:#10B981;
                                  -fx-font-weight:bold;"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>
